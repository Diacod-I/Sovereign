{
  "name": "sovereign",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:probe": "node test/probe.e2e.mjs",
    "test:probe:fixture": "node test/probe.fixture.e2e.mjs",
    "test:handoff": "npx esbuild app/lib/receipts.ts --bundle --format=esm --outfile=/tmp/receipts.mjs --log-level=error && node test/handoff.e2e.mjs",
    "test:attestation": "npx esbuild app/lib/attestation.ts --bundle --format=esm --outfile=/tmp/attestation.mjs --log-level=error && node test/attestation.e2e.mjs",
    "test:hosted": "node test/hosted-worker.e2e.mjs",
    "test:ssrf": "npx esbuild app/lib/ssrf.ts --bundle --format=esm --platform=node --outfile=/tmp/ssrf.mjs --log-level=error && node test/ssrf.e2e.mjs",
    "test:link": "node test/link.e2e.mjs",
    "test:x402": "npx esbuild app/lib/x402-pay.server.ts --bundle --format=esm --platform=node --outfile=./.x402pay.test.mjs --log-level=error --external:@circle-fin/* --external:@privy-io/* --external:viem && node test/x402-pay.e2e.mjs; rm -f ./.x402pay.test.mjs",
    "preflight": "node test/preflight.mjs",
    "test:world": "node test/world-verification.e2e.mjs",
    "test:boundary": "node test/boundary.e2e.mjs"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^3.4.0",
    "@graphprotocol/graph-cli": "^0.98.1",
    "@privy-io/react-auth": "^3.42.0",
    "@worldcoin/idkit": "^4.2.3",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "gsap": "^3.15.0",
    "next": "16.3.4",
    "postprocessing": "^6.39.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "three": "^0.185.1",
    "viem": "^2.56.0",
    "@privy-io/server-auth": "^1.32.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "express": "^5.1.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
