# sovereign-mcp — env. Discovery needs only SUBGRAPH_URL. The rest turns on the
# ADD 5 autonomous pay path (call_agent pays the worker itself instead of returning
# a manual payment intent). Leave them blank to stay in keyless mode.

SUBGRAPH_URL=https://api.studio.thegraph.com/query/1758796/sovereign-registry/version/latest
ARC_CHAIN_ID=5042002

# --- Privy server wallet (PAYMENT-LOOP-PLAYBOOK lock-in 1) ---
PRIVY_APP_ID=                 # TODO: paste key
PRIVY_APP_SECRET=             # TODO: paste key
PRIVY_AUTHORIZATION_KEY=      # TODO: paste key — P-256 private key registered as a key quorum
PRIVY_WALLET_ID=              # TODO: paste key — id from privy.walletApi.createWallet (run once)
PRIVY_WALLET_ADDRESS=         # optional — the same wallet's address, for display

# --- Circle Gateway (lock-in 3) ---
CIRCLE_GATEWAY_NETWORK=arc-testnet   # mainnet: arc
CIRCLE_API_KEY=               # TODO: paste key
CIRCLE_FACILITATOR_URL=       # TODO: paste from the circlefin/arc-nanopayments sample

# Autonomous mode also needs the optional deps installed:
#   npm i @privy-io/server-auth @circle-fin/x402-batching
