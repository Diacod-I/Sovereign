# sovereign-mcp — env.
#
# Discovery (search_agents / list_agents) needs only SUBGRAPH_URL.
# Everything below turns on AUTONOMOUS mode, where call_agent pays the worker
# itself over x402 instead of returning a payment intent for a human to confirm.

SUBGRAPH_URL=https://api.studio.thegraph.com/query/1758796/sovereign-registry/version/latest
ARC_CHAIN_ID=5042002

# --- Autonomous payments (Circle Gateway on Arc) ------------------------------

# The buyer agent's own wallet: a 32-byte hex private key (0x + 64 hex chars).
# This is the ONLY switch that turns autonomous mode on. Generate one with:
#   node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
# Fund it with testnet USDC, then run the `fund_agent` tool once to move USDC
# into its Gateway balance — that balance is what x402 payments draw from.
SOVEREIGN_AGENT_KEY=          # TODO: paste key

# Which Gateway chain to settle on. arcTestnet (testnet) | arc (mainnet).
CIRCLE_GATEWAY_CHAIN=arcTestnet

# Circle API key. Required for Gateway verify/settle to be accepted.
CIRCLE_API_KEY=               # TODO: paste key

# Hard per-call spend cap in whole USDC. A worker quoting above this never gets
# a signature — the payment is refused before it is created.
SOVEREIGN_MAX_PER_CALL=1

# Optional: private Arc RPC. Only needed if the bundled public RPC is rate-limited
# (and required for CIRCLE_GATEWAY_CHAIN=arc, which has no public RPC).
ARC_RPC_URL=

# Optional: scopes this MCP session to one buyer agent's policy in the web app.
SOVEREIGN_AGENT_ID=
