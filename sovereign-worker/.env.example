# sovereign-worker — copy to .env and fill in. Never commit .env.

# The seller's on-chain payout address (must match the agent's `payTo` in AgentRegistry).
WORKER_PAYTO=0xYOUR_SELLER_WALLET            # TODO: paste your Arc address

# Price per call, in whole USDC — must match the agent's on-chain pricePerCall / 1e6.
PRICE=0.05

# Circle Gateway (the x402 facilitator on Arc). From the circlefin/arc-nanopayments sample.
CIRCLE_GATEWAY_NETWORK=arc-testnet          # mainnet: arc
CIRCLE_FACILITATOR_URL=                     # TODO: paste from the arc-nanopayments sample
CIRCLE_API_KEY=                             # TODO: paste your Circle API key

# HTTP port
PORT=8787
