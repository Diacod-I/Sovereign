# sovereign-worker — copy to .env and fill in. Never commit .env.

# The seller's on-chain payout address (must match the agent's `payTo` in
# AgentRegistry). Required — the server refuses to start without it.
WORKER_PAYTO=                 # TODO: paste your Arc address (0x…)

# Price per call, in whole USDC. Must match the agent's on-chain
# pricePerCall / 1e6, or buyers will sign the wrong amount.
PRICE=0.05

# --- Circle Gateway (the x402 facilitator on Arc) -----------------------------

# Testnet default. Mainnet: https://gateway-api.circle.com
CIRCLE_FACILITATOR_URL=https://gateway-api-testnet.circle.com

# Circle API key. Without it, Gateway rejects verify/settle and no call is paid.
CIRCLE_API_KEY=               # TODO: paste your Circle API key

ARC_CHAIN_ID=5042002
PORT=8787

# Local development ONLY: serve /task with no payment gate, so worker logic can
# be exercised offline. Never set this on a deployed worker.
ALLOW_UNPAID=false
